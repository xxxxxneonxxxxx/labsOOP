<Window
    x:Class="ObjectOrientedPractics.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabs="clr-namespace:ObjectOrientedPractics.View.Tabs"
    mc:Ignorable="d">

    <TabControl x:Name="MainTabControl">
        <TabItem x:Name="ItemsTabItem" Header="Items">
            <tabs:ItemsTab x:Name="ItemsTab"/>
        </TabItem>

        <TabItem x:Name="CustomersTabItem" Header="Customers">
            <tabs:CustomersTab x:Name="CustomersTab"/>
        </TabItem>

        <TabItem x:Name="CartsTabItem" Header="Carts">
            <tabs:CartsTab x:Name="CartsTab"/>
        </TabItem>

        <TabItem x:Name="OrdersTabItem" Header="Orders">
            <tabs:OrdersTab x:Name="OrdersTab"/>
        </TabItem>
    </TabControl>
</Window>
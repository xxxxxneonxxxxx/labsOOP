<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="using:ObjectOrientedPractics.View.Tabs"
        x:Class="ObjectOrientedPractics.MainWindow"
        Width="900" Height="600"
        Title="Store Manager">

  <TabControl>
    <TabItem Header="Items">
      <tabs:ItemsTab x:Name="ItemsTab"/>
    </TabItem>

    <TabItem Header="Customers">
      <tabs:CustomersTab x:Name="CustomersTab"/>
    </TabItem>
  </TabControl>
</Window>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ObjectOrientedPractics.View.Tabs.CartsTab"
             Padding="8">

  <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,*,Auto">

    <!-- ВЫБОР ПОКУПАТЕЛЯ -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Margin="0,0,0,8">
      <TextBlock Text="Customer:"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"/>
      <ComboBox x:Name="CustomersComboBox"
                x:FieldModifier="public"
                Width="220"
                SelectedIndex="-1"/>
    </StackPanel>

    <!-- ЛЕВО: СПИСОК ТОВАРОВ -->
    <Border Grid.Row="1" Grid.Column="0"
            Margin="0,0,8,0"
            Padding="6"
            BorderThickness="1"
            BorderBrush="Gray">
      <StackPanel>
        <TextBlock Text="Items"
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>
        <ListBox x:Name="ItemsListBox"
                 x:FieldModifier="public"
                 SelectionMode="Single"/>
      </StackPanel>
    </Border>

    <!-- ПРАВО: КОРЗИНА -->
    <Border Grid.Row="1" Grid.Column="1"
            Margin="8,0,0,0"
            Padding="6"
            BorderThickness="1"
            BorderBrush="Gray">
      <StackPanel>
        <TextBlock Text="Cart"
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>

        <Grid RowDefinitions="*,Auto,Auto">

          <!-- Товары в корзине -->
          <ListBox x:Name="CartItemsListBox"
                   x:FieldModifier="public"
                   Grid.Row="0"
                   SelectionMode="Single"/>

          <!-- Итоговая сумма -->
          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,4,0,0">
            <TextBlock Text="Amount:"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="AmountTextBlock"
                       x:FieldModifier="public"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Кнопки управления -->
          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,4,0,0">
            <Button x:Name="AddToCartButton"
                    x:FieldModifier="public"
                    Content="Add"
                    Margin="0,0,4,0"/>
            <Button x:Name="RemoveItemButton"
                    x:FieldModifier="public"
                    Content="Remove"
                    Margin="0,0,4,0"/>
            <Button x:Name="ClearCartButton"
                    x:FieldModifier="public"
                    Content="Clear"
                    Margin="0,0,4,0"/>
            <Button x:Name="CreateOrderButton"
                    x:FieldModifier="public"
                    Content="Create order"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>